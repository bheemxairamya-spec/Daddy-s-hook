# --- Required in production ---
NODE_ENV="production"
# Admin panel passcode (8+ characters). Admin login is DISABLED in production if this is unset.
ADMIN_PASSCODE=""
# Public URL of your site (used in sitemap.xml)
APP_URL="https://yourdomain.com"

# --- Online payments (optional). Without BOTH keys, only Cash on Delivery is offered. ---
# Get these from the Razorpay dashboard (use live keys for real money).
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# --- Store settings ---
VITE_WHATSAPP_NUMBER="919820411999"
VITE_FREE_DELIVERY_THRESHOLD="1999"
